include LICENSE
include README.md
include MASTER_DOCUMENTATION.md
include CONTRIBUTING.md
include pyproject.toml
include requirements.txt
include requirements-test.txt
include .env.example
include alembic.ini

recursive-include src/lisztserv/frontend/templates *
recursive-include src/lisztserv/frontend/static *
recursive-include migrations *

exclude .gitignore
exclude .coverage
exclude test.db
exclude test_results.log
exclude *.pyc
exclude __pycache__
exclude *.spec
exclude build_standalone.py
exclude hook-lisztserv.py

prune tests
prune htmlcov
prune .pytest_cache
prune .benchmarks
prune logs
prune virtual 